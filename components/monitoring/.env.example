# Grafana Environment Configuration for Docker Compose
# These variables are used to configure Grafana datasources dynamically
# Copy this file to .env and modify values as needed for your environment

# Prometheus Configuration
PROMETHEUS_URL=http://prometheus:9090

# Loki Configuration  
LOKI_URL=http://loki:3100

# Grafana Configuration
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

# LDAP Configuration (optional)
LDAP_ENABLED=false
LDAP_HOST=ldap.example.com
LDAP_PORT=389
LDAP_USE_SSL=false
LDAP_START_TLS=false
LDAP_SKIP_SSL_VERIFY=false
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=password
LDAP_SEARCH_FILTER=(uid=%s)
LDAP_SEARCH_BASE_DNS=ou=people,dc=example,dc=com

# For Kubernetes environments, these will be overridden by ConfigMaps/Secrets
