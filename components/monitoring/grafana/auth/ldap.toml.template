# LDAP Configuration for Grafana - Template Version
# This file uses environment variables for dynamic configuration across environments
# Basic configuration
verbose_logging = true # Enable verbose logging for troubleshooting

[[servers]]
# LDAP server configuration using environment variables
host = "${LDAP_HOST}"
port = ${LDAP_PORT}
use_ssl = ${LDAP_USE_SSL}
start_tls = ${LDAP_START_TLS}
ssl_skip_verify = ${LDAP_SKIP_SSL_VERIFY}

# Authentication configuration
bind_dn = "${LDAP_BIND_DN}"
bind_password = "${LDAP_BIND_PASSWORD}"

# Search configuration
search_filter = "${LDAP_SEARCH_FILTER}"
search_base_dns = ["${LDAP_SEARCH_BASE_DNS}"]

# User mapping - match LLDAP attribute names
[servers.attributes]
name = "givenname"
surname = "sn"
username = "uid"
member_of = "objectclass"
email = "mail"
display_name = "cn"

# Group mappings based on our LDAP defaults.yaml

# Administrators group mapping
[[servers.group_mappings]]
group_dn = "cn=admins,${LDAP_SEARCH_BASE_DNS}"
org_role = "Admin"

# Developers group mapping
[[servers.group_mappings]]
group_dn = "cn=developers,ou=groups,${LDAP_BASE_DN}"
org_role = "Editor"

# Grafana Users group mapping
[[servers.group_mappings]]
group_dn = "cn=grafana_users,ou=groups,${LDAP_BASE_DN}"
org_role = "Editor"

# Viewers group mapping
[[servers.group_mappings]]
group_dn = "cn=viewers,ou=groups,${LDAP_BASE_DN}"
org_role = "Viewer"

# Default mapping for all other groups
[[servers.group_mappings]]
group_dn = "*"
org_role = "Viewer"
